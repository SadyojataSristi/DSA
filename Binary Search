AIM: Find the postion of a element in an array using binary search in c.

ALGORITHM:

Step 1: Start
Step 2: Declare variables n, key, start, mid, end, flag
Step 3: Set flag = 0
Step 4: Read value of n (number of elements)
Step 5: Declare an array arr of size n
Step 6: Input n elements in sorted order
Step 7: Read the element key to search
Step 8: Initialize:
  start = 0
  end = n - 1

Step 9: Repeat while start ≤ end
  a. Compute mid = (start + end) / 2
  b. If arr[mid] == key
    – Print the position mid + 1
    – Set flag = 1
    – Break the loop
  c. Else if arr[mid] < key
    – Set start = mid + 1
  d. Else
    – Set end = mid - 1

Step 10: If flag == 0, print “Element not found”
Step 11: Stop

CODE:

#include<stdio.h>
int main(){
  int n,key,start,mid,end,flag=0;
  printf("Enter number of elements: ");
  scanf("%d",&n);
  int arr[n];
  printf("Enter %d elements in sorted order: ",n);
  for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
  }
  printf("Enter the element to search");
  scanf("%d",&key);
  start=0;
  end=n-1;
  while(start<=end){
    mid=(start+end)/2;
    if(arr[mid]==key){
      printf("Element %d found at position %d\n",key,mid+1);
      flag=1;
      break;
      }
    else if(arr[mid]<key){
      start=mid+1;
    }
    else{
      end=mid-1;
    }
  }
  if(flag==0){
    printf("Element %d not found in the array\n",key);
  }
}
