AIM: To find the position of a number using linear search operation in c.

CODE:

#include<stdio.h>
int main(){
  int n,key,flag=0;
  printf("Enter number of elements: ");
  scanf("%d",&n);
  int arr[n];
  printf("Enter %d elements: \n",n);
  for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
  }
  printf("enter the element to search");
  scanf("%d",&key);
  for(int i=0;i<n;i++){
    if(arr[i]==key){
    flag=1;
    printf("Element %d found at position %d\n",key,i+1);
    break;
    }
  }
  if(flag==0){
  printf("element %d not found",key);
  }
}
